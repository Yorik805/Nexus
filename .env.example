# Copy to .env for local development. Never commit real credentials.
# ==============================================================
# Core Nexus runtime / server settings
# ==============================================================
ORCHESTRATOR_PROVIDER=gemini
NEXUS_CONTEXT_BUILDER_ENABLED=1
NEXUS_PLUGIN_TIMEOUT_SECONDS=30.0

# Dashboard companion process
NEXUS_DASHBOARD_PORT=11882
NEXUS_RUNTIME_URL=http://127.0.0.1:8765

# ==============================================================
# Gemini provider settings (used when ORCHESTRATOR_PROVIDER=gemini)
# ==============================================================
# Use either a single key or a comma-separated failover pool.
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEYS=your-first-key,your-second-key,your-third-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BACKOFF_SECONDS=1
GEMINI_MAX_OUTPUT_TOKENS=16000
GEMINI_CREDENTIAL_COOLDOWN_SECONDS=30

# ==============================================================
# Ollama provider settings (used when ORCHESTRATOR_PROVIDER=ollama)
# ==============================================================
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_RETRIES=2
OLLAMA_RETRY_BACKOFF_SECONDS=1
OLLAMA_MAX_OUTPUT_TOKENS=1024
OLLAMA_KEEP_ALIVE=10m
