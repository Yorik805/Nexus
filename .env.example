# Copy to .env for local development. Never commit real credentials.
ORCHESTRATOR_PROVIDER=gemini
NEXUS_CONTEXT_BUILDER_ENABLED=1
GEMINI_API_KEYS=your-first-key,your-second-key,your-third-key,your-fourth-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BACKOFF_SECONDS=1
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_CREDENTIAL_COOLDOWN_SECONDS=30
# Optional comma-separated failover pool:
# GEMINI_API_KEYS=your-first-key,your-second-key
